# ---------------------------------------------------------------------------
# eSIM MCP server. Copy to .env and fill in for your environment.
# .env is git-ignored; never commit real URLs, salts or credentials.
# ---------------------------------------------------------------------------

# Base URL of the eSIM backend, WITHOUT the /api/v1 suffix.
# Replace with your QA backend URL locally; https is mandatory in production.
ESIM_API_BASE_URL=https://qa-placeholder.example.com

# local | development | qa | staging | production
# Anything other than "production" allows the local stdio development identity.
ESIM_MCP_ENVIRONMENT=development

# stdio (local MCP clients) | streamable-http (deployed)
# Deployed, the MCP endpoint is <base-url>/mcp and the health check is <base-url>/health.
ESIM_MCP_TRANSPORT=stdio

# Bind host. Use 0.0.0.0 on a hosting platform: the loopback default also switches on the
# SDK's localhost-only Host allow-list, which rejects requests arriving via a proxy.
ESIM_MCP_HOST=127.0.0.1

# Bind port. Leave unset on a platform that supplies its own PORT (Render, Heroku, Cloud
# Run) -- setting it here overrides the platform.
ESIM_MCP_PORT=8080

# Secret used to derive the per-client X-Device-Id via HMAC-SHA256.
# Must be >= 32 characters in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it stable, or every client gets a new device id.
ESIM_MCP_DEVICE_ID_SALT=replace-with-a-long-random-value-at-least-32-chars

ESIM_MCP_DEFAULT_LOCALE=en
ESIM_MCP_DEFAULT_CURRENCY=USD

# HTTP client timeouts, in seconds.
ESIM_MCP_CONNECT_TIMEOUT=5
ESIM_MCP_READ_TIMEOUT=20
ESIM_MCP_WRITE_TIMEOUT=20
ESIM_MCP_POOL_TIMEOUT=5

# Read budget for the two authenticated account-history GETs alone -- /user/my-esim behind
# get_my_esims and /user/order-history behind get_order_history. Nothing else uses it, and
# widening it does not widen the general, checkout or purchase budgets.
#
# ESIM_MCP_READ_TIMEOUT is sized for cached catalogue lookups. These two are not cached: the
# platform builds each answer per user and per request, re-reading every bundle the account
# owns and re-localizing every row, so the time grows with the account. On a real account
# that ran past 20s while the portal -- which imposes no budget -- got the same answer.
#
# Two rules travel with this budget and are enforced in code, not by configuration:
#   * one attempt per tool call, never the shared three-attempt read retry (three tries at
#     this budget would hold a chat client for six minutes to say the platform was slow);
#   * a timeout raises the typed account_read_timeout error. It never reads as an empty
#     account, never refreshes the token and never replays. Only a real 401 refreshes, and
#     that replays the read exactly once.
ESIM_MCP_ACCOUNT_READ_TIMEOUT=120

# Read budget for the card-checkout POST alone. It is much larger than ESIM_MCP_READ_TIMEOUT
# on purpose: that one is sized for single cached reads, while the platform's checkout
# endpoint makes six sequential third-party round trips (two eSIM-hub reads, two order-row
# writes, a currency rate and the Stripe Checkout Session) before it can answer. Giving up
# early does not cancel any of that -- the hosted payment page is created regardless, and the
# only thing lost is this server's one chance to read the link and hand it to the user.
ESIM_MCP_CHECKOUT_READ_TIMEOUT=45

# Read budget for the wallet-purchase POST alone, and the largest one here. That route
# delegates to the platform's shared assign flow, which debits the wallet and then PROVISIONS
# AN eSIM against the eSIM hub before it answers -- a measured run took 65s end to end (order
# at +8s, wallet debited at +10s, eSIM issued at +59s, response at +65s). Hanging up cancels
# none of it: the money still leaves and the eSIM is still issued, and all that is lost is
# knowing whether either happened. Note the platform does not honour Idempotency-Key on this
# route, so an unknown outcome cannot be safely retried -- which is why this budget is wide.
ESIM_MCP_PURCHASE_READ_TIMEOUT=90

# Refresh the access token this many seconds before its JWT exp.
ESIM_MCP_TOKEN_REFRESH_WINDOW_SECONDS=120

# How long a pending OTP login challenge stays valid server-side.
ESIM_MCP_LOGIN_CHALLENGE_TTL_SECONDS=300

# How long a prepared purchase quote stays usable, in seconds (30..1800).
# Short on purpose: a quote embeds a catalogue price and a wallet balance, and both go stale.
# Quotes are MCP-local -- they reserve nothing and are lost when this server restarts.
ESIM_MCP_PURCHASE_QUOTE_TTL_SECONDS=300

# Most simultaneously active prepared quotes one signed-in user may hold (1..50).
ESIM_MCP_MAX_ACTIVE_QUOTES_PER_USER=5

# ---------------------------------------------------------------------------
# QA-ONLY eSIM top-up execution. MUST REMAIN false IN PRODUCTION.
# ---------------------------------------------------------------------------
# Enables confirm_esim_topup, which performs a real top-up over the platform's LEGACY
# POST /api/v1/user/bundle/assign-top-up -- the same route the portal uses.
#
# That route is NOT idempotent. It accepts no idempotency key, and the Topup row it writes
# carries neither an ICCID nor a request key, so the platform cannot tell a retry apart from
# a second genuine top-up: a repeated call charges the user twice. It also debits the wallet
# BEFORE provisioning and swallows a failed provisioning, so a charge with no data is
# possible and invisible to this server.
#
# What protection exists is process-local: this server allows one attempt per prepared quote
# and refuses the rest. That lock does not survive a restart, a redeploy or a second replica.
#
# With the flag off (the default) the capability is absent three times over: the tool is not
# registered, the service refuses, and the transport refuses the route. Settings REFUSE TO
# CONSTRUCT when it is true and ESIM_MCP_ENVIRONMENT=production, so a production process with
# it set will not start.
#
# Leave false until the platform provides durable idempotency and wallet compensation.
MCP_ESIM_TOP_UP_ENABLED=false

# DEBUG | INFO | WARNING | ERROR | CRITICAL
ESIM_MCP_LOG_LEVEL=INFO

# Identity used for local stdio development only. Ignored in production, where a
# verified transport principal is required.
ESIM_MCP_DEV_CLIENT_ID=local-dev-client

# ---------------------------------------------------------------------------
# Legacy FastAPI health skeleton in app/ (kept from the initial scaffold).
# ---------------------------------------------------------------------------
APP_NAME=MCP Service
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=false
HOST=127.0.0.1
PORT=8000
